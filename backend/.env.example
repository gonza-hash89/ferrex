PORT=3001
BASE_URL=http://localhost:3001
# Copia este archivo como .env y ajusta en producción.
# Render/Railway inyectan PORT automáticamente. Define BASE_URL con tu URL pública.
# Ej: BASE_URL=https://ga-casero.onrender.com
# CORS_ORIGIN: dominios extra del frontend (coma-separados). Ej: CORS_ORIGIN=https://tu-sitio.netlify.app
CORS_ORIGIN=
# JWT_SECRET: OBLIGATORIO en producción. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# ACCESS_TTL: vida del JWT de acceso (defecto 15m). Refresh en cookie httpOnly: 7 días.
ACCESS_TTL=15m
