# FERREX Backend v2.0 - Environment Variables
# Copia este archivo a .env y completa los valores

# Servidor
NODE_ENV=production
PORT=3001
BASE_URL=https://ferrex-vdex.onrender.com

# Seguridad (OBLIGATORIOS en producción)
JWT_SECRET=tu_clave_secreta_muy_larga_y_aleatoria_aqui_min_32_chars
DATABASE_URL=postgresql://user:pass@host:port/dbname

# CORS
CORS_ORIGIN=https://ferrex-pe.netlify.app

# Configuración opcional
ACCESS_TTL=15m
UPLOAD_DIR=./uploads